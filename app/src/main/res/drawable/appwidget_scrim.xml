<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens a widget's picture at the top for its heading and at the bottom for its title -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:centerColor="#14000000"
        android:centerY="0.35"
        android:endColor="#D1000000"
        android:startColor="#6B000000" />
</shape>

{
    "name": "oolong-crash",
    "main": "src/index.js",
    "compatibility_date": "2026-10-01",
    "d1_databases": [
        { "binding": "DB", "database_name": "oolong-crash", "database_id": "4be23eaf-709d-4dbe-9060-97c5877e7d77" },
        // The feedback bot's database (tools/feedback-bot), which the console shows and sets statuses in
        { "binding": "FEEDBACK", "database_name": "oolong-feedback", "database_id": "ad6eadc8-ed64-46f4-ba9a-83d542524649" }
    ],
    // Private: the mapping file of each build, mapping/<versionName>.bin
    "r2_buckets": [
        { "binding": "MAPPINGS", "bucket_name": "oolong-mappings" }
    ],
    // Runs on a route for the update host's /crash path, passed to deploy (see the README) so that
    // the host stays out of the repository. workers.dev isn't reachable from mainland China
    "workers_dev": false,
    // The console page is a module of its own
    "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
    // Every minute, waiting reports are filed; once a day, what has expired is dropped.
    // ACCESS_TEAM and ACCESS_AUD, which the console checks sign-ins against, are set on the Worker
    "triggers": { "crons": ["* * * * *", "17 3 * * *"] }
}
